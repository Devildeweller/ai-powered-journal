# Both variables are optional.

# Where the Vite dev server forwards /api requests (default: http://localhost:4000).
VITE_DEV_API_TARGET=

# Leave empty to call /api on the same origin (the dev proxy locally, the
# Vercel rewrite in production).  Set it only if the browser must call the API
# on a different origin directly; the API then needs COOKIE_SAMESITE=none.
VITE_API_URL=
