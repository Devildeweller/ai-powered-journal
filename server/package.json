{
  "name": "inkwell-server",
  "version": "1.0.0",
  "private": true,
  "description": "Inkwell API: Express + PostgreSQL/pgvector backend with a RAG chat pipeline and long-term memory.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node scripts/seed.js",
    "reindex": "node scripts/reindex.js",
    "eval:retrieval": "node scripts/evalRetrieval.js",
    "test": "node --test \"tests/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1166.0",
    "@aws-sdk/s3-request-presigner": "^3.1166.0",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@electric-sql/pglite-pgvector": "^0.0.17",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2"
  }
}
