# Copy this file to .env and fill in the values.  Never commit .env.

# ---- Server -----------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of browser origins allowed to call the API directly.
CLIENT_ORIGIN=http://localhost:5173

# ---- Database (PostgreSQL + pgvector) ----------------------------------------
# Neon / Render / any Postgres with the `vector` extension available.
# Leave empty in development to use an embedded Postgres (PGlite) stored in
# server/.data, so the app runs with zero setup.  Required in production.
DATABASE_URL=

# ---- Auth ---------------------------------------------------------------------
# Long random string, 32+ characters.  Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# "lax" when the frontend proxies /api (the default Vercel setup in this repo),
# "none" if the browser calls the API on a different site directly.
COOKIE_SAMESITE=lax

# ---- AI: Google Gemini (chat, memory extraction and embeddings) ----------------
# One key for everything.  Create it at https://aistudio.google.com/apikey
# Note: on Gemini's free tier, Google may use submitted content to improve its
# products.  Use a paid key before putting real private journals through it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the model above is overloaded or out of quota.
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-3.5-flash-lite
# How much the model reasons before answering: minimal | low | medium | high
GEMINI_THINKING_LEVEL=low
GEMINI_EMBEDDING_MODEL=gemini-embedding-2
# gemini | local.  "local" is an offline, keyword-hashing embedder meant for
# development and tests only.  Defaults to gemini when GEMINI_API_KEY is set.
EMBEDDINGS_PROVIDER=

# ---- Long-term memory ----------------------------------------------------------
# Extract durable facts about the user from chats and new journal entries.
MEMORY_EXTRACTION=true

# ---- AWS S3 (image attachments) — optional -------------------------------------
# Leave S3_BUCKET empty to disable attachments.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=

# ---- Demo data (npm run seed) --------------------------------------------------
SEED_EMAIL=demo@inkwell.test
SEED_PASSWORD=inkwell-demo-2026
